<Window x:Class="LocalBell.App.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalBell Widget"
        WindowStyle="None" Background="Transparent" ThemeMode="None"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <!-- A borderless, transparent window over the taskbar, never activated: the widget (NowPlaying's way). Transparent
       through DWM (see TaskbarWidget.xaml.cs), not AllowsTransparency. ThemeMode="None": the Fluent theme of the app
       windows must not paint it; its colours follow the taskbar (Windows' mode). -->
  <Grid Height="40" Margin="0,0,0,0">
    <!-- The bell alone (no favourite): a click opens the flyout. -->
    <Border x:Name="BellPart" Width="40" CornerRadius="4" Background="Transparent" Cursor="Hand"
            MouseLeftButtonUp="BellPart_Click">
      <Grid>
        <Path x:Name="BellIcon" Data="{StaticResource BellGeometry}" Width="18" Height="18" Stretch="Uniform" Fill="White" />
        <TextBlock x:Name="MoonIcon" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      </Grid>
    </Border>

    <!-- The bell and the favourite: a click on them rings it, the arrow opens the flyout. -->
    <StackPanel x:Name="FavoritePart" Orientation="Horizontal" Visibility="Collapsed">
      <Border x:Name="RingPart" CornerRadius="4,0,0,4" Background="Transparent" Cursor="Hand" Padding="10,0,9,0"
              MouseLeftButtonUp="RingPart_Click">
        <StackPanel Orientation="Horizontal">
          <Grid VerticalAlignment="Center">
            <Path x:Name="FavoriteBell" Data="{StaticResource BellGeometry}" Width="16" Height="16" Stretch="Uniform" Fill="White" />
            <TextBlock x:Name="FavoriteMoon" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                       Foreground="White" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="FavoriteName" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="180"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Rectangle x:Name="Divider" Width="1" Height="20" Fill="#40FFFFFF" VerticalAlignment="Center" />
      <Border x:Name="ArrowPart" CornerRadius="0,4,4,0" Background="Transparent" Cursor="Hand" Padding="8,0,9,0"
              MouseLeftButtonUp="ArrowPart_Click">
        <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                   Foreground="White" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <!-- The missed rings -->
    <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" MinWidth="15" Height="15"
            CornerRadius="7.5" Background="#E81123" Padding="4,0" IsHitTestVisible="False" Visibility="Collapsed">
      <TextBlock x:Name="BadgeText" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>

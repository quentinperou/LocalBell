<UserControl x:Class="LocalBell.App.UpdateBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalBell.App"
             Visibility="Collapsed">
  <!-- A newer version on GitHub, over the list (as the bar of PageCompose's and NowPlaying's windows), drawn as the
       banner of "do not disturb": Update installs it from here, What's new opens its page, the cross hides it. -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,9"
          Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
    <DockPanel>
      <!-- Hidden rather than disabled while installing: a disabled button gets a solid background. -->
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Margin="4,0,0,0"
              ToolTip="{local:Tr CloseTooltip}" AutomationProperties.Name="{local:Tr CloseTooltip}" Click="Close_Click">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" />
      </Button>
      <Button x:Name="InstallButton" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Padding="12,4"
              VerticalAlignment="Center" Content="{local:Tr UpdateInstall}" Click="Install_Click" />
      <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="16" Margin="0,0,12,0" />
      <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
        <TextBlock x:Name="Message" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="NotesLink" Style="{StaticResource Secondary}">
          <Hyperlink Click="Notes_Click"><Run Text="{local:Tr UpdateWhatsNew}" /></Hyperlink>
        </TextBlock>
        <ProgressBar x:Name="Progress" Maximum="1" Margin="0,6,0,2" Visibility="Collapsed" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>

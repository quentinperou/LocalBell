<Application x:Class="LocalBell.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalBell.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Windows 11 (Fluent) theme shipped with WPF .NET 9+, following the Windows light/dark mode.
                     App.ApplyTheme switches it (Application.ThemeMode) to the one chosen in Settings. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Colours come from the Fluent theme ({DynamicResource ...Brush}) so that they follow light and dark. -->
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <!-- The counter bell of the icon, in a 24 px box: push button, stem, dome, base. -->
            <GeometryGroup x:Key="BellGeometry" FillRule="Nonzero">
                <EllipseGeometry Center="12,4.2" RadiusX="1.9" RadiusY="1.9" />
                <RectangleGeometry Rect="11.1,5,1.8,4.5" />
                <PathGeometry Figures="M3.2,17.2 A8.8,8.8 0 0 1 20.8,17.2 Z" />
                <RectangleGeometry Rect="1.5,18.4,21,3" RadiusX="1.3" RadiusY="1.3" />
            </GeometryGroup>
            <LinearGradientBrush x:Key="BellGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC24B" Offset="0" />
                <GradientStop Color="#F26B2A" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A square button holding a glyph (Settings, "do not disturb") -->
            <Style x:Key="SquareButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SquareAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A button that is only its content until hovered (the star of a row, the cross of a popup) -->
            <Style x:Key="SubtleButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A ready-made message: a pill, the accent colour once chosen -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="14" Padding="12,5" BorderThickness="1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- "Sonner tout le monde" waiting for its second click (the author's choice A): yellow for 3 s, a bar running out. -->
            <ControlTemplate x:Key="ConfirmEveryoneTemplate" TargetType="Button">
                <Border x:Name="Bg" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBrush}" Height="36">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource BellGeometry}" Width="14" Height="14" Stretch="Uniform" Fill="#1A1A1A" />
                            <TextBlock Text="{Binding ConfirmEveryoneText}" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#1A1A1A" />
                        </StackPanel>
                        <Border Height="3" Margin="4,0,4,2" VerticalAlignment="Bottom" CornerRadius="1.5" Background="#661A1A1A"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Countdown" ScaleX="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Countdown" Storyboard.TargetProperty="ScaleX"
                                                     From="1" To="0" Duration="0:0:3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

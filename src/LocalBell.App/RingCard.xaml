<UserControl x:Class="LocalBell.App.RingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalBell.App"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- The card of a ring: in the popup, and smaller in Settings → Popup to choose its style. -->
    <Grid>
        <!-- Discreet: the size of a Windows notification -->
        <Border x:Name="QuietCard" Width="364" CornerRadius="8" BorderThickness="1" Padding="16"
                BorderBrush="{DynamicResource FlyoutBorderBrush}" Background="{DynamicResource FlyoutBackground}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" VerticalAlignment="Top" Margin="8,-4,-6,0"
                            ToolTip="{local:Tr CloseTooltip}" Click="Close_Click">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                    <Image Source="Assets/LocalBell.png" Width="36" Height="36" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="QuietTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="QuietTime" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
                <Border x:Name="QuietMessageCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,9">
                    <TextBlock x:Name="QuietMessage" FontSize="14" TextWrapping="Wrap" />
                </Border>
                <UniformGrid x:Name="QuietReplies" Rows="1" Margin="-3,12,-3,0" />
            </StackPanel>
        </Border>

        <!-- Loud: an orange band, the name large -->
        <Border x:Name="LoudCard" Width="400" CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource FlyoutBorderBrush}" Background="{DynamicResource FlyoutBackground}">
            <StackPanel>
                <Border CornerRadius="9,9,0,0" Background="{StaticResource BellGradient}" Padding="20,18,12,18">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" VerticalAlignment="Top" Margin="0,-6,0,0"
                                Foreground="White" ToolTip="{local:Tr CloseTooltip}" Click="Close_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="11" />
                        </Button>
                        <Grid Width="60" Height="60">
                            <Path Data="M14,21 A13,13 0 0 0 14,39" Stroke="White" StrokeThickness="2.5" Opacity="0.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M46,21 A13,13 0 0 1 46,39" Stroke="White" StrokeThickness="2.5" Opacity="0.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M8,13 A24,24 0 0 0 8,47" Stroke="White" StrokeThickness="2.5" Opacity="0.45"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M52,13 A24,24 0 0 1 52,47" Stroke="White" StrokeThickness="2.5" Opacity="0.45"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="{StaticResource BellGeometry}" Width="24" Height="24" Stretch="Uniform" Fill="White" />
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LoudName" FontSize="26" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LoudLine" FontSize="13" Foreground="#E6FFFFFF" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel Margin="20,16,20,20">
                    <TextBlock x:Name="LoudMessage" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <UniformGrid x:Name="LoudReplies" Rows="1" Margin="-4,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

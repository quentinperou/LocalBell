<Window x:Class="LocalBell.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalBell.App"
        xmlns:vm="clr-namespace:LocalBell.App.ViewModels"
        Title="{local:Tr SettingsTitle}" Icon="Assets/LocalBell.ico"
        Width="880" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ApplicationBackgroundBrush}"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated" Closed="Window_Closed">

  <!-- The cards of the Settings of PageCompose, on pages chosen from a menu on the left, as in the Windows 11 Settings
       app (the mock-ups the author approved on October 31, 2026). -->
  <Window.Resources>
    <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Rows under the first one of a card, aligned with its title (16 padding + 20 icon + 16 margin). -->
    <Style x:Key="CardSubRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="52,6,16,6" />
    </Style>

    <Style x:Key="CardDivider" TargetType="Rectangle">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="CardIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- The control on the right of a card. -->
    <Style x:Key="CardControl" TargetType="FrameworkElement">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>

    <!-- A page: its cards scroll when the window reaches the height of the screen. -->
    <Style x:Key="Page" TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Visibility" Value="Hidden" />
    </Style>

    <Style x:Key="PageContent" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,24,24" />
    </Style>

    <!-- An entry of the menu: a pale background when chosen or pointed at, an accent bar on the left of the chosen one. -->
    <Style x:Key="MenuItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="36" Background="Transparent">
              <Border x:Name="Back" CornerRadius="4" Background="Transparent" />
              <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                      Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
              <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Windows 11 toggle switch: the Fluent theme has its brushes but no style for it. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource ToggleSwitchFillOff}" BorderBrush="{DynamicResource ToggleSwitchStrokeOff}">
              <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}" />
                <Setter TargetName="Knob" Property="Width" Value="14" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A corner of the little screen: the one chosen filled with the accent colour. -->
    <Style x:Key="CornerOption" TargetType="RadioButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="GroupName" Value="Corner" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Box" CornerRadius="2" BorderThickness="1" Background="Transparent"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The choice of the popup style: a ring with an accent dot. The Fluent radio button, in the dark theme, fills its
         circle with the accent and puts a black dot in it: under a preview it read as a glitch (the author, Oct. 31). -->
    <Style x:Key="OptionRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse x:Name="Ring" StrokeThickness="1.5" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A ready-made message or a reply: its text, its pencil and its bin; the text box while it is edited. -->
    <DataTemplate x:Key="EditableRow" DataType="{x:Type vm:EditableText}">
      <StackPanel>
        <Rectangle Style="{StaticResource CardDivider}" />
        <DockPanel Style="{StaticResource CardSubRow}">
          <Button DockPanel.Dock="Right" Style="{StaticResource SquareButton}" Margin="6,0,0,0" Padding="8,7"
                  ToolTip="{local:Tr DeleteTooltip}" Click="DeleteText_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource SquareButton}" Margin="6,0,0,0" Padding="8,7"
                  ToolTip="{local:Tr EditTooltip}" Click="EditText_Click">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" />
          </Button>
          <Grid VerticalAlignment="Center">
            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                     IsVisibleChanged="EditBox_IsVisibleChanged" LostFocus="EditBox_LostFocus" KeyDown="EditBox_KeyDown" />
          </Grid>
        </DockPanel>
      </StackPanel>
    </DataTemplate>

    <!-- A key of a shortcut, as a key cap. -->
    <Style x:Key="KeyCap" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
    </Style>

    <!-- A row of Keyboard shortcuts (the author's choice A, November 3): the PC (its dot) or the action; on the right
         "Définir", or its keys with a pencil and a bin, or the box that records them. -->
    <DataTemplate x:Key="ShortcutRowTemplate" DataType="{x:Type vm:ShortcutRow}">
      <StackPanel>
        <Rectangle Style="{StaticResource CardDivider}" />
        <DockPanel Style="{StaticResource CardSubRow}" MinHeight="34">
          <Grid DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center">
            <Button x:Name="SetButton" Content="{local:Tr ShortcutSet}" Width="110" Padding="12,5" HorizontalAlignment="Right"
                    Click="SetShortcut_Click" />
            <StackPanel x:Name="KeysPanel" Orientation="Horizontal" Visibility="Collapsed">
              <ItemsControl ItemsSource="{Binding Keys}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="Plus" Text="+" Margin="5,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="{Binding}" FontSize="12" HorizontalAlignment="Center" />
                      </Border>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                        <Setter TargetName="Plus" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource SquareButton}" Margin="16,0,0,0" Padding="8,7" ToolTip="{local:Tr EditTooltip}"
                      Click="SetShortcut_Click">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" />
              </Button>
              <Button Style="{StaticResource SquareButton}" Margin="6,0,0,0" Padding="8,7" ToolTip="{local:Tr DeleteTooltip}"
                      Click="DeleteShortcut_Click">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
              </Button>
            </StackPanel>
            <!-- While recording: the keys held show in it; Échap gives up. -->
            <Border x:Name="RecordBox" Width="250" CornerRadius="4" BorderThickness="2" Padding="10,5" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorInputActiveBrush}">
              <StackPanel>
                <TextBlock Text="{Binding RecordingText}" FontSize="13" />
                <TextBlock x:Name="RecordNote" Style="{StaticResource Secondary}" Text="{Binding RecordingNote}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"
                       Fill="{DynamicResource TextFillColorTertiaryBrush}" />
              <!-- A PC's name as it is now (renamed meanwhile), else the action's. -->
              <TextBlock x:Name="NameText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                  <PriorityBinding>
                    <Binding Path="Peer.Name" />
                    <Binding Path="Name" />
                  </PriorityBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
            <TextBlock x:Name="TakenNote" Style="{StaticResource CardDescription}" Text="{local:Tr ShortcutTaken}" Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasHotkey}" Value="True">
          <Setter TargetName="SetButton" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="KeysPanel" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRecording}" Value="True">
          <Setter TargetName="SetButton" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="KeysPanel" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="RecordBox" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRefused}" Value="True">
          <Setter TargetName="RecordNote" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPc}" Value="True">
          <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
          <Setter TargetName="NameText" Property="Opacity" Value="0.6" />
          <Setter TargetName="TakenNote" Property="Margin" Value="18,2,0,0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Peer.Online}" Value="True">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          <Setter TargetName="NameText" Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTaken}" Value="True">
          <Setter TargetName="TakenNote" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A ring of History (the author's choice A, November 3, as a phone's calls): the arrow (towards this PC or away
         from it), who and the message, then the time and what came of it; "Rappeler" on a ring missed. -->
    <DataTemplate x:Key="HistoryRowTemplate" DataType="{x:Type vm:HistoryRow}">
      <StackPanel>
        <Rectangle x:Name="Line" Style="{StaticResource CardDivider}" />
        <DockPanel Margin="16,9">
          <Path x:Name="Arrow" DockPanel.Dock="Left" Data="M5,15 L15,5 M8,5 L15,5 L15,12" Width="20" Height="20" Margin="0,0,16,0"
                VerticalAlignment="Center" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
          <StackPanel DockPanel.Dock="Right" MaxWidth="320" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Time}" HorizontalAlignment="Right" />
            <DockPanel HorizontalAlignment="Right" Margin="0,2,0,0">
              <TextBlock x:Name="RingBackPart" DockPanel.Dock="Right" FontSize="12" Visibility="Collapsed"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text=" · " /><Hyperlink Click="HistoryRingBack_Click"><Run Text="{local:Tr RingBack}" /></Hyperlink>
              </TextBlock>
              <TextBlock x:Name="OutcomeText" FontSize="12" Text="{Binding Outcome}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Outcome}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Before, Mode=OneWay}" /><Run
                Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding After, Mode=OneWay}" /></TextBlock>
            <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Received}" Value="True">
          <Setter TargetName="Arrow" Property="Data" Value="M15,5 L5,15 M5,8 L5,15 L12,15" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Accent">
          <Setter TargetName="OutcomeText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Success">
          <Setter TargetName="OutcomeText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Caution">
          <Setter TargetName="OutcomeText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Critical">
          <Setter TargetName="OutcomeText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Missed}" Value="True">
          <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource SystemFillColorCriticalBrush}" />
          <Setter TargetName="RingBackPart" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- On the left, as NowPlaying's (asked by the author, October 31): the app and this PC, then the menu; the page
         takes the right column up to the top, with no "Settings" heading over both (the title bar says it). -->
    <DockPanel Margin="16,18,16,0" VerticalAlignment="Top">
      <Image Source="Assets/LocalBell.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="LocalBell" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="ThisPcText" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>

    <!-- The menu: one page each. -->
    <ListBox x:Name="PageList" Grid.Row="1" Margin="16,20,16,24" VerticalAlignment="Top"
             Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0"
             ItemContainerStyle="{StaticResource MenuItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             SelectionChanged="PageList_SelectionChanged" AutomationProperties.Name="{local:Tr SettingsTitle}">
      <ListBoxItem AutomationProperties.Name="{local:Tr PageGeneral}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE713;" />
          <TextBlock Text="{local:Tr PageGeneral}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PageRing}">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource BellGeometry}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0"
                Fill="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock Text="{local:Tr PageRing}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PagePopup}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8A7;" />
          <TextBlock Text="{local:Tr PagePopup}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PageMessages}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8BD;" />
          <TextBlock Text="{local:Tr PageMessages}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PageShortcuts}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE765;" />
          <TextBlock Text="{local:Tr PageShortcuts}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PageHistory}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE81C;" />
          <TextBlock Text="{local:Tr PageHistory}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PageNetwork}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE839;" />
          <TextBlock Text="{local:Tr PageNetwork}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PageUpdates}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE895;" />
          <TextBlock Text="{local:Tr PageUpdates}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr PageAbout}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;" />
          <TextBlock Text="{local:Tr PageAbout}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
    </ListBox>

    <!-- The pages share one place: the hidden ones keep their room, so the window takes the height of the tallest and
         does not jump from page to page. -->
    <Grid Grid.RowSpan="2" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock FontSize="28" FontWeight="SemiBold" Margin="0,18,24,16"
                 Text="{Binding SelectedItem.(AutomationProperties.Name), ElementName=PageList}" />

      <!-- General -->
      <ScrollViewer x:Name="GeneralPage" Grid.Row="1" Style="{StaticResource Page}" Visibility="Visible">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE7F4;" />
              <TextBox x:Name="NameBox" Style="{StaticResource DefaultTextBoxStyle}" DockPanel.Dock="Right" Width="230"
                       VerticalAlignment="Center" Margin="16,0,0,0" MaxLength="40"
                       LostFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr NameTitle}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr NameHint}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE7E8;" />
              <CheckBox x:Name="StartupBox" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Margin="16,0,0,0" Click="StartupBox_Click" AutomationProperties.Name="{local:Tr StartWithWindows}" />
              <!-- The Store version, once the user turned its startup task off in Windows: only Windows turns it on again. -->
              <Button x:Name="StartupAppsButton" DockPanel.Dock="Right" Content="{local:Tr OpenStartupSettings}" VerticalAlignment="Center"
                      Margin="16,0,0,0" Visibility="Collapsed" Click="StartupApps_Click" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr StartWithWindows}" />
                <TextBlock x:Name="StartupNote" Style="{StaticResource CardDescription}" Visibility="Collapsed" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <Path DockPanel.Dock="Left" Data="{StaticResource BellGeometry}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,16,0"
                    Fill="{DynamicResource TextFillColorPrimaryBrush}" />
              <ComboBox x:Name="WidgetBox" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Margin="16,0,0,0"
                        SelectionChanged="WidgetBox_SelectionChanged" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr WidgetTitle}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr WidgetHint}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- As in ScreenClip: what a click on the bell near the clock opens. -->
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE962;" />
              <ComboBox x:Name="TrayClickBox" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Margin="16,0,0,0"
                        SelectionChanged="TrayClickBox_SelectionChanged" AutomationProperties.Name="{local:Tr TrayClickTitle}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr TrayClickTitle}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr TrayClickHint}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE708;" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ComboBox x:Name="DndLengthBox" Width="200" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="DndBox" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="DndBox_Click"
                          AutomationProperties.Name="{local:Tr StatusDnd}" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr StatusDnd}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr DndHint}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE774;" />
              <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Margin="16,0,0,0"
                        SelectionChanged="LanguageBox_SelectionChanged" />
              <TextBlock Text="{local:Tr LanguageTitle}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE790;" />
              <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Margin="16,0,0,0"
                        SelectionChanged="ThemeBox_SelectionChanged" />
              <TextBlock Text="{local:Tr ThemeTitle}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Ring -->
      <ScrollViewer x:Name="RingPage" Grid.Row="1" Style="{StaticResource Page}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <Path DockPanel.Dock="Left" Data="{StaticResource BellGeometry}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,16,0"
                    Fill="{DynamicResource TextFillColorPrimaryBrush}" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ComboBox x:Name="SoundBox" Width="230" VerticalAlignment="Center" SelectionChanged="SoundBox_SelectionChanged" />
                <Button Style="{StaticResource SquareButton}" Margin="6,0,0,0" ToolTip="{local:Tr PlayTooltip}" Click="Play_Click">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14" />
                </Button>
              </StackPanel>
              <TextBlock Text="{local:Tr SoundTitle}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8E5;" />
              <Button DockPanel.Dock="Right" Content="{local:Tr Browse}" Width="230" VerticalAlignment="Center" Margin="16,0,0,0"
                      Click="Browse_Click" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr OwnSoundTitle}" />
                <TextBlock x:Name="OwnSoundText" Style="{StaticResource CardDescription}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE767;" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Slider x:Name="VolumeSlider" Width="186" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                        AutomationProperties.Name="{local:Tr VolumeTitle}" />
                <TextBlock x:Name="VolumeText" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr VolumeTitle}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr VolumeHint}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE74F;" />
              <CheckBox x:Name="MutedBox" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Margin="16,0,0,0" Click="MutedBox_Click" AutomationProperties.Name="{local:Tr RingWhenMuted}" />
              <TextBlock Text="{local:Tr RingWhenMuted}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8EE;" />
              <ComboBox x:Name="RepeatBox" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" Margin="16,0,0,0"
                        SelectionChanged="RepeatBox_SelectionChanged" />
              <TextBlock Text="{local:Tr RepeatTitle}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Popup -->
      <ScrollViewer x:Name="PopupPage" Grid.Row="1" Style="{StaticResource Page}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8A7;" />
                <TextBlock Text="{local:Tr StyleTitle}" VerticalAlignment="Center" />
              </DockPanel>
              <UniformGrid Columns="2" Margin="36,0,0,0">
                <Border x:Name="QuietOption" Margin="0,0,10,0" Padding="12" CornerRadius="6" Cursor="Hand"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" MouseLeftButtonUp="QuietOption_Click">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=QuietRadio}" Value="True">
                          <Setter Property="BorderThickness" Value="2" />
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <Viewbox Height="96" IsHitTestVisible="False">
                      <local:RingCard x:Name="QuietPreview" />
                    </Viewbox>
                    <RadioButton x:Name="QuietRadio" Style="{StaticResource OptionRadio}" GroupName="PopupStyle" Content="{local:Tr StyleQuiet}" HorizontalAlignment="Center"
                                 Margin="0,10,0,0" Checked="StyleRadio_Checked" />
                  </StackPanel>
                </Border>
                <Border x:Name="LoudOption" Padding="12" CornerRadius="6" Cursor="Hand"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" MouseLeftButtonUp="LoudOption_Click">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=LoudRadio}" Value="True">
                          <Setter Property="BorderThickness" Value="2" />
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <Viewbox Height="96" IsHitTestVisible="False">
                      <local:RingCard x:Name="LoudPreview" />
                    </Viewbox>
                    <RadioButton x:Name="LoudRadio" Style="{StaticResource OptionRadio}" GroupName="PopupStyle" Content="{local:Tr StyleLoud}" HorizontalAlignment="Center"
                                 Margin="0,10,0,0" Checked="StyleRadio_Checked" />
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE7F4;" />
              <Border DockPanel.Dock="Right" Width="112" Height="68" CornerRadius="4" BorderThickness="2" Margin="16,0,0,0"
                      BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                      Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <Grid Margin="5">
                  <RadioButton x:Name="TopLeftCorner" Style="{StaticResource CornerOption}" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Checked="Corner_Checked" />
                  <RadioButton x:Name="TopRightCorner" Style="{StaticResource CornerOption}" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Checked="Corner_Checked" />
                  <RadioButton x:Name="BottomLeftCorner" Style="{StaticResource CornerOption}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Checked="Corner_Checked" />
                  <RadioButton x:Name="BottomRightCorner" Style="{StaticResource CornerOption}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Checked="Corner_Checked" />
                </Grid>
              </Border>
              <TextBlock Text="{local:Tr CornerTitle}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE7F8;" />
              <ComboBox x:Name="ScreenBox" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" Margin="16,0,0,0"
                        SelectionChanged="ScreenBox_SelectionChanged" />
              <TextBlock Text="{local:Tr ScreenTitle}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE823;" />
              <ComboBox x:Name="CloseBox" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" Margin="16,0,0,0"
                        SelectionChanged="CloseBox_SelectionChanged" />
              <TextBlock Text="{local:Tr ClosingTitle}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Messages -->
      <ScrollViewer x:Name="MessagesPage" Grid.Row="1" Style="{StaticResource Page}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}" Padding="0">
            <StackPanel>
              <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8BD;" />
                <Button DockPanel.Dock="Right" Content="{local:Tr Add}" VerticalAlignment="Center" Margin="16,0,0,0" Padding="12,5"
                        Click="AddMessage_Click" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr MessagesTitle}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr MessagesHint}" />
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource EditableRow}" Focusable="False" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}" Padding="0">
            <StackPanel>
              <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8FB;" />
                <Button x:Name="AddReplyButton" DockPanel.Dock="Right" Content="{local:Tr Add}" VerticalAlignment="Center"
                        Margin="16,0,0,0" Padding="12,5" Click="AddReply_Click" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr RepliesTitle}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr RepliesHint}" />
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="RepliesList" ItemTemplate="{StaticResource EditableRow}" Focusable="False" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Keyboard shortcuts (the author's choice A, November 3): one a PC, then the app's own; none at first. At most as
           tall as the other pages (they all take the height of the tallest): a long list of PCs scrolls. -->
      <ScrollViewer x:Name="ShortcutsPage" Grid.Row="1" Style="{StaticResource Page}"
                    MaxHeight="{Binding ActualHeight, ElementName=GeneralPage}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}" Padding="0">
            <StackPanel>
              <DockPanel Margin="16,12">
                <Path DockPanel.Dock="Left" Data="{StaticResource BellGeometry}" Width="20" Height="20" Stretch="Uniform"
                      Margin="0,0,16,0" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr ShortcutsRingTitle}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr ShortcutsRingHint}" />
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="PcShortcutsList" ItemTemplate="{StaticResource ShortcutRowTemplate}" Focusable="False" />
              <StackPanel x:Name="NoPcRow" Visibility="Collapsed">
                <Rectangle Style="{StaticResource CardDivider}" />
                <TextBlock Style="{StaticResource CardDescription}" Margin="52,10,16,10" Text="{local:Tr ShortcutsNoPc}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}" Padding="0">
            <StackPanel>
              <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE765;" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="LocalBell" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr ShortcutsAppHint}" />
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="AppShortcutsList" ItemTemplate="{StaticResource ShortcutRowTemplate}" Focusable="False" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- History (the author's choice A, November 3): how long it is kept, then the rings by day. At most as tall as
           the other pages: it scrolls. -->
      <ScrollViewer x:Name="HistoryPage" Grid.Row="1" Style="{StaticResource Page}"
                    MaxHeight="{Binding ActualHeight, ElementName=GeneralPage}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE81C;" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ComboBox x:Name="HistoryKeepBox" Width="190" VerticalAlignment="Center"
                          SelectionChanged="HistoryKeepBox_SelectionChanged" AutomationProperties.Name="{local:Tr HistoryKeepTitle}" />
                <Button x:Name="HistoryClearButton" Content="{local:Tr HistoryClear}" Margin="8,0,0,0" Padding="12,5"
                        VerticalAlignment="Center" Click="HistoryClear_Click" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr HistoryKeepTitle}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr HistoryKeepHint}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock x:Name="HistoryEmptyText" Style="{StaticResource CardDescription}" Margin="2,14,0,0" Text="{local:Tr HistoryEmpty}" />
          <ItemsControl x:Name="HistoryList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HistoryDay}">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,14,0,8" />
                  <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HistoryRowTemplate}" Focusable="False" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Network -->
      <ScrollViewer x:Name="NetworkPage" Grid.Row="1" Style="{StaticResource Page}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE839;" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="AddressText" VerticalAlignment="Center" />
                <Button Style="{StaticResource SquareButton}" Margin="10,0,0,0" Padding="8,7" ToolTip="{local:Tr CopyTooltip}"
                        Click="CopyAddress_Click">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="14" />
                </Button>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr AddressTitle}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr AddressHint}" />
                <TextBlock x:Name="OtherAddressesText" Style="{StaticResource CardDescription}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}" Padding="0">
            <StackPanel>
              <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE710;" />
                <Button DockPanel.Dock="Right" Content="{local:Tr AddByAddress}" VerticalAlignment="Center" Margin="16,0,0,0"
                        Padding="12,5" Click="ShowAddAddress_Click" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr ManualTitle}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr ManualHint}" />
                </StackPanel>
              </DockPanel>
              <StackPanel x:Name="AddAddressRow" Visibility="Collapsed">
                <Rectangle Style="{StaticResource CardDivider}" />
                <DockPanel Style="{StaticResource CardSubRow}">
                  <Button x:Name="AddAddressButton" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}"
                          Content="{local:Tr Add}" Margin="8,0,0,0" Padding="14,5" VerticalAlignment="Center" Click="AddAddress_Click" />
                  <Grid VerticalAlignment="Center">
                    <TextBox x:Name="AddressBox" KeyDown="AddressBox_KeyDown" />
                    <TextBlock Text="{local:Tr AddressPlaceholder}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DockPanel>
              </StackPanel>
              <TextBlock x:Name="AddAddressResult" Style="{StaticResource CardDescription}" Margin="52,0,16,8" Visibility="Collapsed" />
              <ItemsControl x:Name="AddressesList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Rectangle Style="{StaticResource CardDivider}" />
                      <DockPanel Style="{StaticResource CardSubRow}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SquareButton}" Padding="8,7"
                                ToolTip="{local:Tr DeleteTooltip}" Click="DeleteAddress_Click">
                          <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                        </Button>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE72C;" />
              <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="{local:Tr Refresh}" Width="230" VerticalAlignment="Center"
                      Margin="16,0,0,0" Click="Refresh_Click" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FoundText" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr FoundHint}" />
                <!-- The UDP port of the announcements was taken (another program, Hyper-V, WSL, Docker). -->
                <TextBlock x:Name="UdpNote" Style="{StaticResource CardDescription}" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Updates, as PageCompose's page: the version and what the last check found, the check / install button, then
           the startup check and the channel. The Store version: the Store updates it. -->
      <ScrollViewer x:Name="UpdatesPage" Grid.Row="1" Style="{StaticResource Page}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border x:Name="GitHubUpdatesCard" Style="{StaticResource SettingCard}" Padding="0">
            <StackPanel>
              <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE895;" />
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" MinWidth="230" VerticalAlignment="Center"
                        Margin="16,0,0,0" Click="UpdateButton_Click" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="InstalledVersionText" />
                  <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CardDescription}" />
                  <TextBlock x:Name="UpdateNotesLink" Style="{StaticResource CardDescription}" Visibility="Collapsed">
                    <Hyperlink Click="UpdateNotes_Click"><Run Text="{local:Tr UpdateWhatsNew}" /></Hyperlink>
                  </TextBlock>
                  <ProgressBar x:Name="UpdateProgress" Maximum="1" Margin="0,8,0,2" Visibility="Collapsed" />
                </StackPanel>
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <CheckBox x:Name="CheckAtStartupBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Click="CheckAtStartup_Click"
                          AutomationProperties.Name="{local:Tr UpdateCheckAtStartup}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr UpdateCheckAtStartup}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr UpdateCheckAtStartupDescription}" />
                </StackPanel>
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <ComboBox x:Name="ChannelBox" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center"
                          Margin="16,0,0,0" SelectionChanged="ChannelBox_SelectionChanged"
                          AutomationProperties.Name="{local:Tr UpdateChannel}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr UpdateChannel}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr UpdateChannelDescription}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border x:Name="StoreUpdatesCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE719;" />
              <Button DockPanel.Dock="Right" Content="{local:Tr OpenStore}" MinWidth="230" VerticalAlignment="Center"
                      Margin="16,0,0,0" Click="OpenStore_Click" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr UpdatesByStore}" />
                <TextBlock x:Name="StoreVersionText" Style="{StaticResource CardDescription}" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- About -->
      <ScrollViewer x:Name="AboutPage" Grid.Row="1" Style="{StaticResource Page}">
        <StackPanel Style="{StaticResource PageContent}">
          <Border Style="{StaticResource SettingCard}">
            <DockPanel>
              <Image DockPanel.Dock="Left" Source="Assets/LocalBell.png" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LocalBell" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr AboutCredits}" />
                <TextBlock Style="{StaticResource CardDescription}">
                  <Hyperlink NavigateUri="https://github.com/quentinperou/LocalBell" RequestNavigate="Link_RequestNavigate">
                    <Run Text="{local:Tr SourceCode}" />
                  </Hyperlink>
                </TextBlock>
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- Developer mode (as in ScreenClip and TextCase): a log of what LocalBell does, never the messages. -->
          <Border Style="{StaticResource SettingCard}" Padding="0">
            <StackPanel>
              <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xEC7A;" />
                <CheckBox x:Name="DeveloperModeBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Click="DeveloperMode_Click"
                          AutomationProperties.Name="{local:Tr DeveloperMode}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr DeveloperMode}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr DeveloperModeDescription}" />
                </StackPanel>
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Margin="52,10,16,10">
                <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Content="{local:Tr DeveloperLogOpen}" MinWidth="160"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="OpenLog_Click" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{local:Tr DeveloperLog}" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr DeveloperLogDescription}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>

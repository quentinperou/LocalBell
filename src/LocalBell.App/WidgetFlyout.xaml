<Window x:Class="LocalBell.App.WidgetFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalBell.App"
        xmlns:vm="clr-namespace:LocalBell.App.ViewModels"
        Title="{local:Tr AppTitle}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" SizeToContent="Height" Width="344"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">

  <!-- The flyout of the widget (the approved mock-up): the missed rings and "Rappeler", the PCs, the message, everyone.
       A margin of 12 for its shadow, which is a layer of its own (an effect on the content would blur its text). -->
  <Grid Margin="12">
    <Border CornerRadius="8" Background="{DynamicResource FlyoutBackground}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.4" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="8" BorderThickness="1" Padding="10"
            BorderBrush="{DynamicResource FlyoutBorderBrush}" Background="{DynamicResource FlyoutBackground}">
      <StackPanel>
        <!-- A new version (the author's choice A among two, October 31): the banner of the window, made for the panel.
             Its button installs from the window, whose banner shows the progress. -->
        <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10,8" Visibility="Collapsed"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Padding="10,4" FontSize="13"
                    VerticalAlignment="Center" Content="{local:Tr UpdateInstall}" Click="UpdateInstall_Click" />
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="15" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock x:Name="UpdateTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource Secondary}">
                <Hyperlink Click="UpdateNotes_Click"><Run Text="{local:Tr UpdateWhatsNew}" /></Hyperlink>
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- The missed rings -->
        <ItemsControl ItemsSource="{Binding MissedRings}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:MissedRing}">
              <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,6"
                      Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="6,3"
                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                          Command="{Binding DataContext.RingBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{local:Tr RingBack}" FontSize="12" />
                  </Button>
                  <Path Data="{StaticResource BellGeometry}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                        Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                  <TextBlock Text="{Binding Text}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The PCs -->
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl ItemsSource="{Binding Peers}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PeerItem}">
                <Border x:Name="Row" Padding="8,5" CornerRadius="4" Background="Transparent">
                  <DockPanel>
                    <!-- As "Sonner" in the list: the accent colour of Windows, a plain button for a PC in "do not
                         disturb" (the author found the plain one gave no sign of being clickable, October 31). -->
                    <Grid x:Name="RingButton" DockPanel.Dock="Right" VerticalAlignment="Center">
                      <Button Style="{StaticResource AccentButtonStyle}" Padding="9,5"
                              AutomationProperties.Name="{Binding RingLabel}" ToolTip="{Binding RingLabel}"
                              Command="{Binding DataContext.RingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource BellGeometry}" Width="13" Height="13" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      </Button>
                      <Button Padding="9,5"
                              AutomationProperties.Name="{Binding RingLabel}" ToolTip="{Binding RingLabel}"
                              Command="{Binding DataContext.RingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsDoNotDisturb, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource BellGeometry}" Width="13" Height="13" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      </Button>
                    </Grid>
                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="2,0,10,0" VerticalAlignment="Center"
                             Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="NoteText" Text="{Binding Note}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding IsDoNotDisturb}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Online}" Value="False">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                    <Setter TargetName="RingButton" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding NoteKind}" Value="Quiet">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding NoteKind}" Value="Failed">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding NoteKind}" Value="Replied">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding NoteKind}" Value="Closed">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding NoteKind}" Value="Unanswered">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Style="{StaticResource Secondary}" Text="{local:Tr Searching}" Margin="8,4" TextWrapping="Wrap"
                   Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />

        <Rectangle Height="1" Margin="0,8" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- The message, the ready-made ones, everyone (in two clicks) -->
        <Grid>
          <TextBox x:Name="MessageBox" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" />
          <TextBlock Text="{local:Tr MessagePlaceholder}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=MessageBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,8,0,0" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ChipItem}">
              <Button Style="{StaticResource ChipButton}" Content="{Binding Text}"
                      Command="{Binding DataContext.ChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="0,2,0,0">
          <Button HorizontalAlignment="Stretch" Padding="0,6" Command="{Binding RingEveryoneCommand}"
                  AutomationProperties.Name="{local:Tr RingEveryone}"
                  Visibility="{Binding IsConfirmingEveryone, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource BellGeometry}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="{local:Tr RingEveryone}" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button Command="{Binding RingEveryoneCommand}" Cursor="Hand" HorizontalAlignment="Stretch"
                  Template="{StaticResource ConfirmEveryoneTemplate}" AutomationProperties.Name="{Binding ConfirmEveryoneText}"
                  Visibility="{Binding IsConfirmingEveryone, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
